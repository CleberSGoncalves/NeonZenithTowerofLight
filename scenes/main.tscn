[ext_resource type="PackedScene" path="res://scenes/level_select.tscn" id="4_level_select_scn"]

[sub_resource type="GDScript" id="GDScript_main"]
script/source = "extends Node2D

@onready var level_select: Control = $LevelSelect

func _ready() -> void:
	if GameManager:
		GameManager.start_new_game()
	if EventBus:
		if not EventBus.pause_requested.is_connected(_on_pause_requested):
			EventBus.pause_requested.connect(_on_pause_requested)
		if not EventBus.level_select_requested.is_connected(_on_level_select_requested):
			EventBus.level_select_requested.connect(_on_level_select_requested)

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and (event.keycode == KEY_ESCAPE or event.keycode == KEY_P):
		_toggle_level_select()

func _toggle_level_select() -> void:
	if level_select:
		level_select.visible = not level_select.visible
		get_tree().paused = level_select.visible

func _on_pause_requested() -> void:
	get_tree().paused = true

func _on_level_select_requested() -> void:
	_toggle_level_select()

func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_FOCUS_OUT:
		if EventBus and not get_tree().paused:
			EventBus.pause_requested.emit()
"

