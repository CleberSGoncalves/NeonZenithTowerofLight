; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but can also be edited by text editors.

config_version=5

[application]

config/name="Neon Zenith: Tower of Light"
config/description="Jogo Godot 4: Parkour 3D / Obby - Neon Zenith: Tower of Light"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/game_manager.gd"
EventBus="*res://scripts/event_bus.gd"
SaveSystem="*res://scripts/save_system.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/dpi/allow_hidpi=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.5

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=1

[threading]

export/threads_enabled=false
